{
  "name": "frontmatter-md",
  "version": "2.0.0",
  "description": "Lightweight YAML frontmatter parser for Markdown files.",
  "keywords": [
    "frontmatter",
    "front-matter",
    "markdown",
    "markdown-parser",
    "md",
    "parser",
    "frontmatter-parser",
    "yaml",
    "metadata"
  ],
  "homepage": "https://sefinek.net",
  "bugs": {
    "url": "https://github.com/sefinek/frontmatter-md/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefinek/frontmatter-md.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://sefinek.net/donate"
  },
  "license": "MIT",
  "author": "Sefinek <contact@sefinek.net> (https://sefinek.net)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "lint": "eslint .",
    "m": "ncu -u && npm install && npm update",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.14.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
